<Window x:Class="DnsPanel.MainForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS-пульт" Icon="DnsPanel.ico"
        Width="1000" Height="720" MinWidth="840" MinHeight="635"
        WindowStartupLocation="CenterScreen" Background="#F0F5F2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="#1B3028" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B3028"/>
        <SolidColorBrush x:Key="Muted" Color="#52675E"/>
        <SolidColorBrush x:Key="Line" Color="#DAE5DE"/>
        <SolidColorBrush x:Key="Accent" Color="#9BF0CA"/>
        <SolidColorBrush x:Key="Positive" Color="#146B4E"/>
        <SolidColorBrush x:Key="PositiveFill" Color="#E6F6EE"/>
        <SolidColorBrush x:Key="Caution" Color="#815316"/>
        <SolidColorBrush x:Key="CautionFill" Color="#FFF2D7"/>
        <SolidColorBrush x:Key="Negative" Color="#9C3F3C"/>
        <SolidColorBrush x:Key="NegativeFill" Color="#FAECEA"/>
        <SolidColorBrush x:Key="Waiting" Color="#52675E"/>
        <SolidColorBrush x:Key="WaitingFill" Color="#EDF2EF"/>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".83"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".67"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#328B69"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".62"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#102C22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#204C43"/>
            <Setter Property="Foreground" Value="#F4FFF9"/>
            <Setter Property="BorderBrush" Value="#53766B"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style x:Key="ProfileItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F6F2"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E0F2E9"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#BEE4D3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#419477"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdapterCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="MinWidth" Value="143"/>
            <Setter Property="MaxWidth" Value="250"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,6"/></Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chip" Background="White" BorderBrush="#D5E4DB" BorderThickness="1" CornerRadius="10">
                                            <Path Data="M 1 1 L 5 5 L 9 1" Stroke="#4B685C" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#E8F6EE"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#55A884"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock x:Name="SelectedAdapterText"
                                       Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Нет подключения}"
                                       Margin="11,0,27,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="White" BorderBrush="#CADCD2" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ServiceCard">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="13,13,13,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="27" Height="27" CornerRadius="8" Background="#ECF5F0" Margin="0,0,8,0">
                            <Path Data="{Binding Glyph}" Stroke="#267657" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Background="{Binding Fill}" HorizontalAlignment="Left" Padding="7,4" CornerRadius="6">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding Tone}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0" MinHeight="32"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="#F0F5F2">
        <Grid Margin="26,21,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="57"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="logo.png" Width="50" Height="50" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DNS-пульт" FontSize="25" FontWeight="Bold" Margin="0,-3,0,0"/>
                        <TextBlock Text="DNS-over-HTTPS" Foreground="{StaticResource Muted}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сетевой адаптер" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AdapterPicker" Style="{StaticResource AdapterCombo}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Сетевой адаптер" SelectionChanged="AdapterChanged"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="13,14,13,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="6,0,4,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="DNS-профили" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ButtonBase}"
                                    Width="34" MinHeight="34" Padding="0" ToolTip="Проверить DNS и сервисы"
                                    AutomationProperties.Name="Проверить DNS и сервисы" Click="RefreshClicked">
                                <Path Data="M 14 6 A 5 5 0 1 0 14 12 M 14 2 L 14 6 L 10 6"
                                      Stroke="{StaticResource Positive}" StrokeThickness="1.55"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Сервер" Foreground="{StaticResource Muted}" FontSize="12" Margin="7,0,8,6"/>
                        <TextBlock Grid.Row="1" Text="Отклик DNS" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,6"/>
                        <ListBox x:Name="ProfileList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource ProfileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="DNS-профили" SelectionChanged="ProfileChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Tone}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{Binding Tone}" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Padding="23,18,23,19" CornerRadius="21" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#122E2A" Offset="0"/>
                                    <GradientStop Color="#1B493E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Canvas Width="167" Height="110" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,-4,0" Opacity=".24" IsHitTestVisible="False">
                                    <Path Data="M 7 88 H 47 Q 54 88 61 76 L 106 19 Q 112 12 121 12 H 158 M 38 29 H 61 Q 66 29 76 41 L 109 80 Q 116 88 123 88 H 158"
                                          Stroke="#9CF2CC" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="2" Canvas.Top="83" Width="10" Height="10" Fill="#9CF2CC"/>
                                    <Ellipse Canvas.Left="153" Canvas.Top="7" Width="10" Height="10" Fill="#9CF2CC"/>
                                    <Ellipse Canvas.Left="34" Canvas.Top="25" Width="8" Height="8" Fill="#9CF2CC"/>
                                    <Ellipse Canvas.Left="154" Canvas.Top="84" Width="8" Height="8" Fill="#9CF2CC"/>
                                </Canvas>
                                <StackPanel>
                                    <TextBlock x:Name="ProfileTitle" Text="MagicDNS" FontSize="34" FontWeight="Bold" Foreground="#F1FFF9"/>
                                    <TextBlock x:Name="ProfileHost" Text="dns.magicdns.ru" FontSize="14" Foreground="#C7E4D7" Margin="0,0,0,15"/>
                                    <WrapPanel>
                                        <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Применить DNS" Click="ApplyClicked" Margin="0,0,8,0"/>
                                        <Button x:Name="AutoButton" Style="{StaticResource HeroButton}" Content="Авто" Click="AutoClicked"
                                                ToolTip="Выбрать DNS-профиль с минимальным временем ответа и применить его"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Доступ к сервисам" FontSize="21" FontWeight="SemiBold" Margin="0,17,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ContentControl x:Name="ChatCard" ContentTemplate="{StaticResource ServiceCard}"/>
                            <ContentControl x:Name="GeminiCard" Grid.Column="2" ContentTemplate="{StaticResource ServiceCard}"/>
                        </Grid>
                        <TextBlock Text="Проверка сайта по HTTPS без входа в аккаунт." Foreground="{StaticResource Muted}" FontSize="12" Margin="1,9,0,0"/>
                        <Border CornerRadius="15" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,11" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="DNS адаптера" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock x:Name="SystemDns" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="RestoreButton" Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Вернуть исходный DNS"
                                        Click="RestoreClicked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ActionStatus" Foreground="{StaticResource Positive}" FontSize="13" TextWrapping="Wrap" Margin="1,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
